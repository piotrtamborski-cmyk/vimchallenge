# Copy to apps/web/.env.local for development; never commit the real file.
# Without any of these, `npm run dev` still signs in with email links printed to its log.

# Where the site is reached; forms must come from this origin.
# PUBLIC_URL=http://localhost:3100

# The accounts database (relative to apps/web).
# DATABASE_PATH=.data/vimchallenge.db

# GitHub OAuth app with callback http://localhost:3100/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth client (web) with redirect URI http://localhost:3100/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Send real emails through Resend instead of printing them.
# RESEND_API_KEY=
# MAIL_FROM=vimchallenge <sign-in@example.com>

# A production build on a test server (plain HTTP only): print sign-in links to the log too.
# MAIL_TO_LOG=1
