{
  "name": "vimchallenge",
  "private": true,
  "description": "Learn Vim techniques, practise them in a real editor and compete on the same tasks.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/engine && tsc -p packages/tasks && tsc -p packages/judge && tsc -p packages/conformance && tsc -p apps/web",
    "test": "vitest run",
    "conformance": "npm run -w @vimchallenge/conformance run --",
    "dev": "npm run -w @vimchallenge/web dev",
    "judge": "npm run -w @vimchallenge/judge start",
    "build": "npm run -w @vimchallenge/web build",
    "conformance:browser": "npm run -w @vimchallenge/conformance browser --"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
